# ==============================================================================
# PERCEPTIOSPHERE (P-Sphere) SYSTEM FIREWALL
# Goal: Track the Protocol (Logic) and Structure, Ignore the Data (Context).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OS & IDE CLEANUP
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
*.tmp
.vscode/
.idea/

# ------------------------------------------------------------------------------
# 2. OBSIDIAN SYSTEM FILES
# ------------------------------------------------------------------------------
# Ignore workspace and cache — these are local to each machine
.obsidian/workspace.json
.obsidian/graph.json
.obsidian/appearance.json
.obsidian/core-plugins.json
.obsidian/cache/

# ------------------------------------------------------------------------------
# 3. THE "STRUCTURE ONLY" RULE
# Ignore all content in data folders by default.
# These folders hold YOUR knowledge — they are never shared via Git.
# ------------------------------------------------------------------------------
01_Inflow/**/*
02_Sandbox/**/*
03_Curated/**/*
04_Efforts/**/*
_Archived/**/*

# ------------------------------------------------------------------------------
# 4. WHITELIST: WHAT WE ACTUALLY TRACK
# ------------------------------------------------------------------------------

# Allow the folder structure to be committed via .keep files
!**/
!**/.keep

# Track the entire Protocol engine (Prompts, Schemas, Templates)
!00_Protocol/
!00_Protocol/**/*

# Track brand context samples (not actual brand files)
!04_Efforts/.brand/context.sample.md

# ------------------------------------------------------------------------------
# 5. LOCAL CONFIGURATION (never committed)
# ------------------------------------------------------------------------------
# Your actual opencode.json has real model IDs and endpoints.
# Use opencode.json.sample as a starting template.
opencode.json
.env
local_config.yaml
*.secret
